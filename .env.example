# Copy to .env. `npm run server`, `npm run dev` and `npm run dev:nilm` load .env when it exists.
# APEIRON_PORT=5183
# APEIRON_DB=.data/apeiron.sqlite
# APEIRON_OWNER_TOKEN=use-a-private-long-random-secret-in-deployment
# APEIRON_UI_PORT=5182
# Simulator-only adapter settings:
# APEIRON_API=http://127.0.0.1:5183
# APEIRON_GATEWAY_TOKEN=private-gateway-token
# SIM_INTERVAL_MS=2000
# Assistant, cloud option only. Never committed; read by the backend, never sent to the browser.
# ANTHROPIC_API_KEY=sk-ant-...
# Assistant, local option (LM Studio):
# NILM_LM_URL=http://localhost:8000
# NILM_LM_MODEL=lfm3-1.7b
# NILM installation (npm run dev:nilm):
# NILM_SERIAL=COM6
# NILM_REPLAY=pipeline/tests/data/session_small.txt
